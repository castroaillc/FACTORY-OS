# --- Models (bring your own keys) ---
# Any "provider:model" supported by LangChain initChatModel. Models run on the
# host; these keys never enter the sandbox.
ORCHESTRATOR_MODEL=anthropic:claude-opus-5-5
SUBAGENT_MODEL=anthropic:claude-sonnet-5-5
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Local models (no API key). Use "ollama:<model>" or "openai-compatible:<model>"
# as ORCHESTRATOR_MODEL / SUBAGENT_MODEL or per agent in the dashboard.
# The model must support tool calling (e.g. gpt-oss, qwen3, qwen2.5-coder).
OLLAMA_BASE_URL=http://localhost:11434
# Context window; agent prompts are long, keep this >= 32768
OLLAMA_NUM_CTX=32768
OLLAMA_KEEP_ALIVE=30m
# LM Studio (default :1234/v1), vLLM (:8000/v1), llama.cpp server (:8080/v1)
OPENAI_COMPATIBLE_BASE_URL=http://localhost:1234/v1
OPENAI_COMPATIBLE_API_KEY=

# --- LangSmith (tracing + sandboxes) ---
LANGSMITH_API_KEY=
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=sdl-team

# --- Sandbox ---
# Create once with: pnpm --filter agents sandbox:snapshot
SANDBOX_SNAPSHOT_ID=
SANDBOX_WORKDIR=/workspace
SANDBOX_VCPUS=2
SANDBOX_MEMORY_GB=4
# Seconds, multiples of 60
SANDBOX_IDLE_TTL_SECONDS=1800
SANDBOX_DELETE_AFTER_STOP_SECONDS=3600
SANDBOX_COMMAND_TIMEOUT_SECONDS=600
# Comma-separated outbound allow-list (defaults: GitHub + npm/yarn/PyPI registries)
SANDBOX_ALLOWED_HOSTS=
# true = stop instead of delete the sandbox after a CLI run (for debugging)
SANDBOX_KEEP=false

# --- GitHub ---
GITHUB_REPO=
# Fine-grained token scoped to GITHUB_REPO: Contents + Pull requests (read/write).
# Sent to the sandbox proxy as a write-only secret; never stored in the sandbox.
GITHUB_TOKEN=
GITHUB_BASE_BRANCH=main
# Repos the dashboard may point agents at (comma-separated). Empty = any repo the token can access
GITHUB_ALLOWED_REPOS=
AGENT_BRANCH_PREFIX=agent/
GIT_AUTHOR_NAME=SDL Agent
GIT_AUTHOR_EMAIL=sdl-agent@users.noreply.github.com
