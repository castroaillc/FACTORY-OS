# --- Models (bring your own keys) ---
# Any "provider:model" supported by LangChain initChatModel.
ORCHESTRATOR_MODEL=anthropic:claude-opus-5-5
SUBAGENT_MODEL=anthropic:claude-sonnet-5-5
# Set the key(s) for the provider(s) you use
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- LangSmith tracing ---
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=sdl-team

# --- GitHub ---
# Repo the team works on (owner/name). Cloned into WORKSPACE_DIR on first run.
GITHUB_REPO=
# Fine-grained token scoped to that repo: Contents (read/write) + Pull requests (read/write)
GITHUB_TOKEN=
GITHUB_BASE_BRANCH=main
AGENT_BRANCH_PREFIX=agent/
WORKSPACE_DIR=./workspace

GIT_AUTHOR_NAME=SDL Agent
GIT_AUTHOR_EMAIL=sdl-agent@users.noreply.github.com
SHELL_TIMEOUT_SECONDS=300
