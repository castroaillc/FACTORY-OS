# Better Auth — generate a secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# PostgreSQL
DATABASE_URL=postgres://postgres:postgres@localhost:5432/next_monorepo

# OAuth providers (optional — buttons fail gracefully until set)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Site URL (canonical URLs, sitemap, Open Graph, llms.txt)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Payload CMS — generate a secret with: openssl rand -base64 32
PAYLOAD_SECRET=
# Optional: store media uploads on Vercel Blob instead of local disk
BLOB_READ_WRITE_TOKEN=

# Analytics & tracking (each loads only after cookie consent)
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_META_PIXEL_ID=
